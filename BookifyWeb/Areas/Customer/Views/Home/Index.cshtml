@model IEnumerable<Product>

<div class="row pb-3">
    @foreach (var product in Model)
    {
        <div class="col-lg-3 col-sm-6">
            <div class="row p-2">
                <div class="col-12 p-1">
                    <!-- Card Structure -->
                    <div class="card border-0 shadow border-top border-5 rounded">
                        <!-- Product Image -->
                        @if(product.ProductImages!=null&& product.ProductImages.Count() > 0){
                            <img src="@product.ProductImages.FirstOrDefault().ImageUrl" class="card-img-top rounded" />
                        }
                        else
                        {
                            <img src="https://placehold.co/500x600/png" class="card-img-top rounded" />
                        }
                        @* <img src="@product.ImageUrl" class="card-img-top rounded" /> *@
                        <div class="card-body pb-0">
                            <div class="pl-1">
                                <p class="card-title h5 text-dark opacity-75 text-uppercase text-center">@product.Title</p>
                                <p class="card-title h5 text-dark opacity-75 text-uppercase text-center">@product.Author</p>
                            </div>
                            <div class="pl-1">
                                <p class="text-dark opacity-75 text-center mb-0">
                                    List Price <span class="text-decoration-line-through">@product.ListPrice.ToString("c")</span>
                                </p>
                            </div>
                            <div class="pl-1">
                                <p class="text-dark opacity-75 text-center">
                                    AS low as: <span>@product.Price100.ToString("c")</span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Button for Details -->
                    <div>
                        <a asp-action="Details" asp-route-productId="@product.Id" class="btn btn-primary bg-gradient border-0 form-control">
                            Details
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Show message if no products are available -->
@if (!Model.Any())
{
    <p>No products found.</p>
}
