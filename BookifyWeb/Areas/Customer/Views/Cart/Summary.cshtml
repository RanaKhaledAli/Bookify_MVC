@model ShoppingCartVM

<form method="post">
    @Html.AntiForgeryToken()
    <br />
    <div class="container">
        <div class="card shadow border-0 col-md-6 mx-auto d-flex flex-column">
            <!-- Use Flexbox -->
            <div class="card-header bg-secondary bg-gradient text-light py-2">
                <div class="row px-2">
                    <div class="col-6">
                        <h5 class="pt-1 small">Order Summary</h5>
                    </div>
                    <div class="col-6 text-end">
                        <a asp-action="Index" class="btn btn-outline-light btn-sm">Back to Cart</a>
                    </div>
                </div>
            </div>
            <div class="card-body p-3 flex-grow-1 overflow-auto">
                <!-- Make the body scrollable -->
                <div class="row">
                    <!-- Shipping Info -->
                    <div class="col-12 col-lg-6 pb-2">
                        <h4 class="text-info small">Shipping Details:</h4>
                        <div class="form-group">
                            <label asp-for="OrderHeader.Name" class="small"></label>
                            <input asp-for="OrderHeader.Name" class="form-control form-control-sm" />
                            <span asp-validation-for="OrderHeader.Name" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="OrderHeader.PhoneNumber" class="small"></label>
                            <input asp-for="OrderHeader.PhoneNumber" class="form-control form-control-sm" />
                            <span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="OrderHeader.StreetAdress" class="small"></label>
                            <input asp-for="OrderHeader.StreetAdress" class="form-control form-control-sm" />
                            <span asp-validation-for="OrderHeader.StreetAdress" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="OrderHeader.City" class="small"></label>
                            <input asp-for="OrderHeader.City" class="form-control form-control-sm" />
                            <span asp-validation-for="OrderHeader.City" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="OrderHeader.State" class="small"></label>
                            <input asp-for="OrderHeader.State" class="form-control form-control-sm" />
                            <span asp-validation-for="OrderHeader.State" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="OrderHeader.PostalCode" class="small"></label>
                            <input asp-for="OrderHeader.PostalCode" class="form-control form-control-sm" />
                            <span asp-validation-for="OrderHeader.PostalCode" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Order Summary -->
                    <div class="col-12 col-lg-5 offset-lg-1">
                        <h4 class="text-info small">Order Summary:</h4>
                        <ul class="list-group mb-2">
                            @if (Model.ShoppingCartList != null && Model.ShoppingCartList.Any())
                            {
                                foreach (var item in Model.ShoppingCartList)
                                {
                                    <li class="list-group-item d-flex justify-content-between">
                                        <div>
                                            <h6 class="small">@item.Product.Title</h6>
                                            <small class="text-muted">Quantity: @item.Count</small>
                                        </div>
                                                  <span>@((item.Price * item.Count).ToString("c"))</span>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="list-group-item">Your cart is empty.</li>
                            }
                            <li class="list-group-item d-flex justify-content-between bg-light">
                                <small class="text-info">Total (USD)</small>
                                <strong class="text-info">@Model.OrderHeader.OrderTotal.ToString("c")</strong>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="card-footer p-2">
                <!-- Reduced padding -->
                <div class="row">
                    <div class="col-md-8 pt-1">
                        <p style="color:maroon; font-size: small;">
                            Estimate Arrival Date:
                            @DateTime.Now.AddDays(7).ToShortDateString() - @DateTime.Now.AddDays(14).ToShortDateString()
                        </p>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary form-control"
                        @(Model.ShoppingCartList == null || !Model.ShoppingCartList.Any() ? "disabled" : "")>
                            Place Order
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}